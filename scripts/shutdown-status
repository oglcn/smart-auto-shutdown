#!/bin/bash
# Smart Auto-Shutdown Status Utility

CONFIG_FILE="/etc/smart-auto-shutdown.conf"
STATE_FILE="/var/run/smart-shutdown-state"

IDLE_THRESHOLD=3600
CPU_THRESHOLD=20
BOOT_DELAY="8h"
CHECK_INTERVAL="10min"

if [ -f "$CONFIG_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONFIG_FILE"
fi

C_GREEN='\033[0;32m'
C_RED='\033[0;31m'
C_YELLOW='\033[1;33m'
C_CYAN='\033[0;36m'
C_BOLD='\033[1m'
C_RESET='\033[0m'

echo ""
echo -e "${C_BOLD}╔══════════════════════════════════════╗${C_RESET}"
echo -e "${C_BOLD}║    Smart Auto-Shutdown Status        ║${C_RESET}"
echo -e "${C_BOLD}╚══════════════════════════════════════╝${C_RESET}"
echo ""

if systemctl is-active --quiet autoshutdown.timer 2>/dev/null; then
    echo -e "  Monitoring : ${C_GREEN}● ACTIVE${C_RESET}"
    NEXT=$(systemctl list-timers autoshutdown.timer --no-pager 2>/dev/null | grep autoshutdown | awk '{print $1, $2, $3}')
    [ -n "$NEXT" ] && echo -e "  Next check : ${C_CYAN}${NEXT}${C_RESET}"
else
    echo -e "  Monitoring : ${C_RED}● INACTIVE${C_RESET}"
fi

echo -e "  Uptime     : $(uptime -p)"
echo ""

SSH_COUNT=$(ss -tn state established sport = :22 2>/dev/null | tail -n +2 | wc -l)
CPU_USAGE=$(top -bn2 -d 0.5 2>/dev/null | grep "Cpu(s)" | tail -1 | awk '{print $2}')

echo -e "${C_BOLD}  System State${C_RESET}"
echo -e "  SSH conns  : ${SSH_COUNT}"
echo -e "  CPU usage  : ${CPU_USAGE:-N/A}"
echo ""

if [ -f "$STATE_FILE" ]; then
    IDLE_START=$(cat "$STATE_FILE")
    CURRENT_TIME=$(date +%s)
    IDLE_DURATION=$((CURRENT_TIME - IDLE_START))
    REMAINING=$((IDLE_THRESHOLD - IDLE_DURATION))
    IDLE_MIN=$((IDLE_DURATION / 60))
    REMAINING_MIN=$((REMAINING / 60))

    echo -e "  ${C_YELLOW}⚠  IDLE COUNTDOWN IN PROGRESS${C_RESET}"
    echo -e "  Idle for     : ${IDLE_MIN} min"
    echo -e "  Shutdown in  : ${REMAINING_MIN} min"
else
    echo -e "  ${C_GREEN}✓  No shutdown pending${C_RESET}"
fi

echo ""
echo -e "${C_BOLD}  Configuration${C_RESET}"
echo -e "  Boot delay       : ${BOOT_DELAY}"
echo -e "  Check interval   : ${CHECK_INTERVAL}"
echo -e "  Idle threshold   : $((IDLE_THRESHOLD / 60)) min"
echo -e "  CPU threshold    : ${CPU_THRESHOLD}%"
echo ""
